    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <!-- 封皮：偶奇填充挖出封面标签。 -->
    <path
        android:fillColor="@color/launch_brand_mark"
        android:fillType="evenOdd"
        android:pathData="M122,104 H170 A8,8 0 0 1 178,112 V176 A8,8 0 0 1 170,184 H122 A8,8 0 0 1 114,176 V112 A8,8 0 0 1 122,104 Z M132.4,120 H159.6 A6.4,6.4 0 0 1 166,126.4 V129.6 A6.4,6.4 0 0 1 159.6,136 H132.4 A6.4,6.4 0 0 1 126,129.6 V126.4 A6.4,6.4 0 0 1 132.4,120 Z" />
    <!-- 装订环：圆心压在封皮左缘上，与封皮同色叠成一个轮廓。 -->
    <path
        android:fillColor="@color/launch_brand_mark"
        android:pathData="M110,120 A4,4 0 1 0 118,120 A4,4 0 1 0 110,120 Z M110,136 A4,4 0 1 0 118,136 A4,4 0 1 0 110,136 Z M110,152 A4,4 0 1 0 118,152 A4,4 0 1 0 110,152 Z M110,168 A4,4 0 1 0 118,168 A4,4 0 1 0 110,168 Z" />
</vector>
